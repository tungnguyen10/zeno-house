{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/offline", "destination": "/offline.html" }],
  "ignoreCommand": "echo \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -q '^chore(release):'; test $? -ne 0",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
